{
  "name": "park",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "typecheck": "tsc && tsc -p tsconfig.test.json && tsc -p curate",
    "preview": "vite preview",
    "curate": "bun curate/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "bun run test && bun run test:e2e"
  },
  "dependencies": {
    "lucide-solid": "^1.49.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.3"
  }
}
